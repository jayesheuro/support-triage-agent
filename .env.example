# ============================================================
# Support Triage App — environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit it.
# ============================================================

# --- Gemini (optional — only needed when provider: gemini in configs/app.yaml) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- AWS Bedrock (optional — only needed when provider: bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- App settings (rarely overridden via env; prefer configs/app.yaml) ---
# LOG_LEVEL=INFO
